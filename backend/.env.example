# Database
DATABASE_URL=postgresql://user:password@localhost:5432/maildesk

# Redis
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://YOUR-BACKEND.railway.app/auth/google/callback

# Google Pub/Sub (for Gmail push notifications)
GOOGLE_PUBSUB_TOPIC=projects/YOUR-PROJECT-ID/topics/maildesk-gmail

# JWT
JWT_SECRET=change-this-to-a-long-random-string

# App URLs
FRONTEND_URL=https://your-app.vercel.app
PORT=3001

# Environment
NODE_ENV=production
